 * API Configuration - DEVELOPMENT/LOCAL
 * 
 * This file overrides the default config.js settings for local development.
 * Copy this file as config.local.js and customize for your setup.
 * 
 * Include in your HTML BEFORE api.js:
 * <script src="config.js"></script>
 * <script src="config.local.js"></script>  <!-- Optional, for local overrides -->
 * <script src="api.js"></script>
 */

